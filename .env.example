# SUPABASE (Muninn)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=

# HUGINN MODE
HUGINN_MODE=claude_orchestrator

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_API_KEY_EXEC=
DEEPSEEK_API_KEY_REASON=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL_EXEC=deepseek-chat
DEEPSEEK_MODEL_REASON=deepseek-reasoner

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_API_KEY_ORCH=
ANTHROPIC_API_KEY_BOOST=
CLAUDE_MODEL_ORCH=claude-sonnet-4-6
CLAUDE_MODEL_BOOST=claude-opus-4-6

# Features
LLM_BOOST_ENABLED=false
LLM_VALIDATE_ENABLED=false
MAX_ITERATIONS=30
EXEC_TIMEOUT=30
MAX_SUBAGENTS=3
SUBAGENT_MAX_ITER=8

# Browser
BROWSER_TOOLS=true
BROWSER_HEADLESS=true

# Channels
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=
HUGINN_AUTH_KEYWORD=wodan

WHATSAPP_ENABLED=false
WHATSAPP_ALLOWED_SENDER=
WHATSAPP_SESSION_DIR=./huginn_sessions/whatsapp

INSTAGRAM_ENABLED=false
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=
INSTAGRAM_SESSION_DIR=./huginn_sessions/instagram
INSTAGRAM_POLL_INTERVAL=20
# Polling guidance: <15s increases detection risk; 15-30s recommended; >30s acceptable with higher latency.

# Server
HUGINN_HOST=0.0.0.0
HUGINN_PORT=8000
HUGINN_WEBHOOK_BASE=

# Logging
LOG_DIR=./logs
LOG_TOKENS=true
VERBOSE=false

# Muninn CLI defaults
DEFAULT_MODEL=deepseek
